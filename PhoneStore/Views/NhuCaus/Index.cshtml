@model IEnumerable<PhoneStore.Models.NhuCau>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tennhucau)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thutu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kichhoat)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tennhucau)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thutu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kichhoat)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Nhucauid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Nhucauid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Nhucauid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
