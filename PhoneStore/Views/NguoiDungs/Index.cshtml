@model IEnumerable<PhoneStore.Models.NguoiDung>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tendangnhap)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Matkhau)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hoten)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sodienthoai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Diachi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hangthanhvien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Diemthuong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vaitro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kichhoat)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tendangnhap)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Matkhau)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hoten)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sodienthoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diachi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Hangthanhvien)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diemthuong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vaitro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kichhoat)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Nguoidungid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Nguoidungid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Nguoidungid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
