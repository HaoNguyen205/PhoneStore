@model IEnumerable<PhoneStore.Models.KhuyenMaiSanPham>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Noidungkm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sanpham)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Noidungkm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sanpham.Sanphamid)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Kmid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Kmid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Kmid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
