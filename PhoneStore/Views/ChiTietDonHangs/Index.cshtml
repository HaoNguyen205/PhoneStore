@model IEnumerable<PhoneStore.Models.ChiTietDonHang>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Soluong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dongia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bienthe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Donhang)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Soluong)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Dongia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Bienthe.Bientheid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Donhang.Donhangid)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Chitietid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Chitietid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Chitietid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
