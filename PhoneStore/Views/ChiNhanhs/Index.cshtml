@model IEnumerable<PhoneStore.Models.ChiNhanh>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Khuvuc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tenchinhanh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Diachi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sodienthoai)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Khuvuc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tenchinhanh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diachi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sodienthoai)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Chinhanhid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Chinhanhid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Chinhanhid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
