@model IEnumerable<PhoneStore.Models.BinhLuan>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Binhluanid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nguoidang)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sosao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Noidung)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ngaybinhluan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kichhoat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sanpham)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Binhluanid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nguoidang)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sosao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Noidung)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ngaybinhluan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kichhoat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sanpham.Sanphamid)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
